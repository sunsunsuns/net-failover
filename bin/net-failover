#!/usr/bin/env python3
"""net-failover — 多上行链路自动切换守护进程.

按"链路健康度"自动把默认路由切到当前可用的最高优先级链路；每条可用链路都保留
自己的自然 metric 默认路由作为备份，因此主链路消失时内核会立刻改道，几乎零断流。

设计要点见 docs/DESIGN.md。配置文件默认 /etc/net-failover/config.ini。
"""

import configparser
import concurrent.futures
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import time

DEFAULT_CONFIG = os.environ.get("NET_FAILOVER_CONFIG", "/etc/net-failover/config.ini")
SO_BINDTODEVICE = 25


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def run(cmd, timeout=8):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


class Config:
    """把 INI 解析成运行时对象。"""

    def __init__(self, path):
        self.path = path
        cp = configparser.ConfigParser()
        if not cp.read(path, encoding="utf-8"):
            raise SystemExit("net-failover: 读不到配置文件 %s" % path)

        general = cp["general"] if cp.has_section("general") else {}
        self.promote_metric = _int(general, "promote_metric", 50)
        self.dry_run = _bool(general, "dry_run", False)
        self.state_file = general.get("state_file", "/run/net-failover-gw.json")
        self.on_switch_hook = general.get("on_switch_hook", "").strip()

        probe = cp["probe"] if cp.has_section("probe") else {}
        raw = probe.get("targets", "223.5.5.5:443, 119.29.29.29:443")
        self.targets = []
        for item in raw.split(","):
            item = item.strip()
            if not item:
                continue
            host, _, port = item.rpartition(":")
            self.targets.append((host, int(port)))
        if not self.targets:
            raise SystemExit("net-failover: probe.targets 不能为空")
        self.timeout = _float(probe, "timeout", 1.5)
        self.interval = _float(probe, "interval", 1.5)
        self.strikes_down = _int(probe, "strikes_down", 3)
        self.strikes_up = _int(probe, "strikes_up", 3)
        self.cooldown = _float(probe, "cooldown", 15)
        # 新链路必须先连续健康这么久，才有资格被提升（防止 NM 重连抖动时来回切）
        self.settle = _float(probe, "settle", 8)

        self.links = []
        for section in cp.sections():
            if not section.startswith("link:"):
                continue
            name = section.split(":", 1)[1]
            device = cp[section].get("device", "").strip()
            if not device:
                continue
            self.links.append({
                "name": name,
                "device": device,
                "metric": _int(cp[section], "metric", 600 + len(self.links) * 100),
                "rssi_down": _opt_int(cp[section], "rssi_down"),
                "rssi_up": _opt_int(cp[section], "rssi_up"),
            })
        if not self.links:
            raise SystemExit("net-failover: 配置里没有任何 [link:*] 段")


def _int(section, key, default):
    try:
        return int(section.get(key, default))
    except (ValueError, TypeError):
        return default


def _float(section, key, default):
    try:
        return float(section.get(key, default))
    except (ValueError, TypeError):
        return default


def _opt_int(section, key):
    """可选整数：没配或配错都返回 None（= 不启用该限制）。"""
    raw = section.get(key, "").strip()
    if not raw:
        return None
    try:
        return int(raw)
    except ValueError:
        return None


def _bool(section, key, default):
    val = section.get(key, str(default)).strip().lower()
    return val in ("1", "true", "yes", "on")


def dev_addr(dev):
    r = run(["ip", "-4", "-o", "addr", "show", "dev", dev, "scope", "global"])
    if not r or r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        parts = line.split()
        if "inet" in parts:
            return parts[parts.index("inet") + 1]
    return None


def defaults():
    r = run(["ip", "-4", "route", "show", "default"])
    out = []
    if r and r.returncode == 0:
        for line in r.stdout.splitlines():
            p = line.split()
            if "dev" not in p:
                continue
            out.append((
                p[p.index("dev") + 1],
                p[p.index("via") + 1] if "via" in p else None,
                int(p[p.index("metric") + 1]) if "metric" in p else 0,
            ))
    return out


def get_rssi(dev):
    """读无线信号强度（dBm）。非无线/未连接返回 None。"""
    r = run(["iw", "dev", dev, "link"], timeout=4)
    if r and r.returncode == 0:
        m = re.search(r"signal:\s*(-?\d+)\s*dBm", r.stdout)
        if m:
            return int(m.group(1))
    try:
        with open("/proc/net/wireless", encoding="utf-8") as f:
            for line in f:
                if line.strip().startswith(dev + ":"):
                    parts = line.replace(".", " ").split()
                    # iface: status link level noise ...
                    return int(float(parts[3]))
    except Exception:
        pass
    return None


class GatewayCache:
    """网关四重兜底：已有路由 -> nmcli -> 缓存 -> 网段+1。"""

    def __init__(self, state_file):
        self.state_file = state_file
        try:
            with open(state_file, encoding="utf-8") as f:
                self.cache = json.load(f)
        except Exception:
            self.cache = {}

    def save(self):
        try:
            tmp = self.state_file + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.cache, f)
            os.replace(tmp, self.state_file)
        except Exception:
            pass

    def get(self, dev):
        # 1) NetworkManager 认的活跃连接网关最可信（多地址网卡如 AP+STA 时尤其重要）
        r = run(["nmcli", "-g", "IP4.GATEWAY", "device", "show", dev])
        if r and r.returncode == 0 and r.stdout.strip():
            gw = r.stdout.strip().splitlines()[0].strip()
            if gw and gw != "--":
                self.cache[dev] = gw
                return gw
        # 2) 现存的默认路由
        for d, g, _m in defaults():
            if d == dev and g:
                self.cache[dev] = g
                return g
        # 3) 用 NM 报的地址推算（不是 ip addr 的第一条，避免拿到 AP 网段地址）
        r = run(["nmcli", "-g", "IP4.ADDRESS", "device", "show", dev])
        candidates = []
        if r and r.returncode == 0:
            candidates = [x.strip() for x in r.stdout.splitlines() if x.strip()]
        addr = dev_addr(dev)
        if addr:
            candidates.append(addr)
        for cand in candidates:
            try:
                iface = ipaddress.IPv4Interface(cand)
                if iface.network.prefixlen <= 30:
                    gw = str(iface.network.network_address + 1)
                    if gw != str(iface.ip):
                        self.cache[dev] = gw
                        return gw
            except Exception:
                continue
        return self.cache.get(dev)


class Daemon:
    def __init__(self, cfg):
        self.cfg = cfg
        self.gw = GatewayCache(cfg.state_file)
        self.bad = {}
        self.good = {}
        self.healthy_since = {}
        self.last_none = 0.0
        self.hold_until = 0.0

    # ---------- 探测 ----------
    def _probe_once(self, dev, host, port):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(self.cfg.timeout)
        try:
            s.setsockopt(socket.SOL_SOCKET, SO_BINDTODEVICE, dev.encode())
            s.connect((host, port))
            return True
        except Exception:
            return False
        finally:
            s.close()

    def probe(self, dev):
        if not dev_addr(dev):
            return False
        for host, port in self.cfg.targets:
            if self._probe_once(dev, host, port):
                return True
        return False

    def probe_all(self):
        devices = [link["device"] for link in self.cfg.links]
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(devices)) as pool:
            return dict(zip(devices, pool.map(self.probe, devices)))

    # ---------- 路由 ----------
    def set_route(self, dev, gw, metric):
        cmd = ["ip", "-4", "route", "replace", "default", "via", gw,
               "dev", dev, "metric", str(metric)]
        if self.cfg.dry_run:
            log("[dry-run] %s" % " ".join(cmd))
            return True
        for extra in ([], ["onlink"]):
            r = run(cmd + extra)
            if r is not None and r.returncode == 0:
                return True
        log("添加路由失败 %s gw=%s m=%d: %s"
            % (dev, gw, metric, ((r.stderr if r else "") or "").strip()))
        return False

    def ensure_backup_routes(self):
        # 先把不属于本工具的默认路由 metric 归位（例如 dhclient 默认加的 metric 0，
        # 它会压过所有链路，让切换失效）
        for link in self.cfg.links:
            dev = link["device"]
            if not dev_addr(dev):
                continue
            for d, _g, m in defaults():
                if d == dev and m not in (link["metric"], self.cfg.promote_metric):
                    run(["ip", "-4", "route", "del", "default", "dev", d, "metric", str(m)])

        have = {(d, m) for d, _g, m in defaults()}
        for link in self.cfg.links:
            dev, metric = link["device"], link["metric"]
            if not dev_addr(dev) or (dev, metric) in have:
                continue
            for d, _g, m in defaults():
                if m == metric and d != dev:  # 同 metric 的残留路由会顶掉我们
                    if self.cfg.dry_run:
                        log("[dry-run] ip route del default dev %s metric %d" % (d, metric))
                    else:
                        run(["ip", "-4", "route", "del", "default", "dev", d,
                             "metric", str(metric)])
            gw = self.gw.get(dev)
            if gw:
                self.set_route(dev, gw, metric)

    # ---------- 决策 ----------
    def switch_hook(self, old, new):
        if not self.cfg.on_switch_hook:
            return
        try:
            subprocess.run(self.cfg.on_switch_hook, shell=True, timeout=10)
        except Exception as e:
            log("on_switch_hook 失败: %s" % e)

    def step(self):
        self.ensure_backup_routes()
        self.gw.save()

        promoted = next((d for d, _g, m in defaults() if m == self.cfg.promote_metric), None)
        health = self.probe_all()
        gws = {link["device"]: self.gw.get(link["device"]) for link in self.cfg.links}
        rssi = {link["device"]: get_rssi(link["device"]) for link in self.cfg.links}

        def state(link):
            """返回 (可维持, 可升格)。信号落在 [rssi_down, rssi_up) 区间时：
            当前正在用就维持，但不会再被主动切回来（回滞）。"""
            dev = link["device"]
            if not health.get(dev) or not gws.get(dev):
                return False, False
            if link.get("rssi_up") is None:
                return True, True
            rs = rssi.get(dev)
            if rs is None:
                return True, True
            ok = link.get("rssi_down") is None or rs >= link["rssi_down"]
            good = rs >= link["rssi_up"]
            return ok, good

        states = {link["device"]: state(link) for link in self.cfg.links}
        best = next((link["device"] for link in self.cfg.links if states[link["device"]][1]), None)

        now = time.time()
        # 记录每条链路已经连续健康了多久：新链路必须"站稳"才能被提升
        for dev in health:
            if health[dev]:
                self.healthy_since.setdefault(dev, now)
            else:
                self.healthy_since.pop(dev, None)

        if best is None:
            if now - self.last_none > 60:
                log("无健康上行 %s，维持现有路由" % {l["device"]: health[l["device"]]
                                                  for l in self.cfg.links})
                self.last_none = now
            return

        def settled(dev):
            return now - self.healthy_since.get(dev, now) >= self.cfg.settle

        def fmt_rssi(dev):
            val = rssi.get(dev)
            return "" if val is None else " @%ddBm" % val

        def promote(dev, msg):
            if self.set_route(dev, gws[dev], self.cfg.promote_metric):
                log(msg)
                self.hold_until = now + self.cfg.cooldown
                self.switch_hook(promoted, dev)
                self.bad.clear()
                self.good.clear()
                return True
            return False

        if promoted == best:
            self.bad.clear()
            self.good.clear()
            return

        # 当前链路"有地址但不健康"才算真的坏了；没地址说明设备被临时摘掉
        # （比如 NetworkManager 重启），此时内核已经落到备份路由，先别急着换。
        if promoted is not None and dev_addr(promoted) and not states.get(promoted, (False, False))[0]:
            self.bad[promoted] = self.bad.get(promoted, 0) + 1
            if self.bad[promoted] >= self.cfg.strikes_down and settled(best):
                promote(best, "切换 %s%s -> %s%s [原链路失败/信号差] (gw=%s)"
                        % (promoted, fmt_rssi(promoted), best, fmt_rssi(best), gws[best]))
        else:
            if promoted is None:
                # 主路由已消失（设备被摘掉），内核已落到备份路由；
                # 此时提升新链路只是改 metric，不会造成额外中断。
                if settled(best):
                    promote(best, "启用 %s 为主出口%s (gw=%s)" % (best, fmt_rssi(best), gws[best]))
            elif now < self.hold_until:
                return
            elif settled(best):
                self.good[best] = self.good.get(best, 0) + 1
                if self.good[best] >= self.cfg.strikes_up:
                    promote(best, "更高优先级恢复：%s%s -> %s%s (gw=%s)"
                            % (promoted, fmt_rssi(promoted), best, fmt_rssi(best), gws[best]))

    def run(self):
        order = " > ".join(link["device"] for link in self.cfg.links)
        log("net-failover 启动：%s，探测 %s，配置 %s%s"
            % (order, self.cfg.targets, self.cfg.path, " (dry-run)" if self.cfg.dry_run else ""))
        while True:
            try:
                self.step()
            except Exception as e:
                log("异常：%s" % e)
            time.sleep(self.cfg.interval)


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_CONFIG
    Daemon(Config(path)).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
