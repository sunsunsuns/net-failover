#!/usr/bin/env python3
"""zt-boot-connect — 开机后尽快把 ZeroTier 拉上线。

开机时 ZeroTier 常常比网络先起来（systemd 的 network-online.target 在 WiFi 还没
拿到地址时就满足了），它连不上根服务器后进入退避，等网络恢复也要等很久才重试。

本脚本：等网络真正可用 -> 若 ZT 还没上线就重启它 -> 等它上线 -> 触发一次地址自愈。
这样开机后几秒内就能 ping 通虚拟内网。
"""

import os
import socket
import subprocess
import sys
import time

TARGETS = [("223.5.5.5", 443), ("119.29.29.29", 443)]
NET_TIMEOUT = 180.0
ZT_TIMEOUT = 90.0
SERVICE = "zerotier-one"
PROBE_INTERVAL = 1.0


def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), msg, flush=True)


def run(cmd, timeout=20):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def net_ok():
    for host, port in TARGETS:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(2)
        try:
            s.connect((host, port))
            return True
        except Exception:
            continue
        finally:
            s.close()
    return False


def zt_online():
    r = run(["zerotier-cli", "info"])
    if r is None or r.returncode != 0:
        return False
    out = (r.stdout or "").upper()
    return "ONLINE" in out and "OFFLINE" not in out


def main():
    t0 = time.time()
    log("等待网络就绪…")
    while time.time() - t0 < NET_TIMEOUT:
        if net_ok():
            break
        time.sleep(PROBE_INTERVAL)
    else:
        log("网络 %.0fs 内未就绪，放弃（交给 zt-watchdog）" % NET_TIMEOUT)
        return 1

    t_net = time.time() - t0
    log("网络就绪，用时 %.1fs" % t_net)

    if not zt_online():
        log("ZeroTier 尚未上线，重启服务以立即重连")
        run(["systemctl", "restart", SERVICE], timeout=90)

    t1 = time.time()
    while time.time() - t1 < ZT_TIMEOUT:
        if zt_online():
            log("ZeroTier 已上线，网络就绪后 %.1fs（开机后共 %.1fs）"
                % (time.time() - t1 - 0.0, time.time() - t0))
            break
        time.sleep(PROBE_INTERVAL)
    else:
        log("ZeroTier 在 %.0fs 内仍未上线，交给 zt-watchdog" % ZT_TIMEOUT)

    # 地址自愈：网络切换后 ZT 偶尔不把 IP 加回网卡（厂商脚本，存在才调用）
    fix = "/usr/local/bin/wt-zt-fix.sh"
    if os.path.exists(fix):
        run([fix, "--now"], timeout=60)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
